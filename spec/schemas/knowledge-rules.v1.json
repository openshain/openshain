{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge/rules/*.yaml",
  "description": "The company's own rules, each with the source behind it and the days it is in effect.",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "rules": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "statement": {
            "type": "string",
            "minLength": 10,
            "maxLength": 240
          },
          "aliases": {
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            }
          },
          "applies_to": {
            "type": "object",
            "properties": {
              "profession": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[a-z0-9][a-z0-9._-]*$"
                }
              }
            },
            "required": [
              "profession"
            ],
            "additionalProperties": false
          },
          "scope": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "visibility": {
                    "type": "string",
                    "const": "company"
                  }
                },
                "required": [
                  "visibility"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "principals": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[a-z0-9][a-z0-9._-]*$"
                    }
                  }
                },
                "required": [
                  "principals"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "roles": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200,
                      "pattern": "^[a-z0-9][a-z0-9._-]*$"
                    }
                  }
                },
                "required": [
                  "roles"
                ],
                "additionalProperties": false
              }
            ]
          },
          "effective_from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "effective_to": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "supersedes": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[a-z0-9][a-z0-9._-]*$"
          },
          "expertise": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "source": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              },
              "section": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "statement",
          "effective_from",
          "effective_to",
          "expertise",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "rules"
  ],
  "additionalProperties": false
}
