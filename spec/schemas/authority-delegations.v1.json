{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "authority/delegations.yaml",
  "description": "Who the agent may act for, as which profession, and when.",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "delegations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "principal": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "profession": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "valid_from": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "principal",
          "profession"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version"
  ],
  "additionalProperties": false
}
