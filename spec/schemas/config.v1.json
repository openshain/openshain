{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "openshain.yaml",
  "description": "The company workspace manifest as written on disk.",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "company": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "language": {
          "default": "ja",
          "type": "string",
          "enum": [
            "ja",
            "en"
          ]
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "principal": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "profession": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100000
        }
      },
      "required": [
        "id",
        "instructions"
      ],
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "api_key_env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "base_url": {
          "type": "string",
          "format": "uri"
        },
        "options": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {}
        }
      },
      "required": [
        "provider",
        "model",
        "api_key_env"
      ],
      "additionalProperties": false
    },
    "tools": {
      "default": [
        {
          "provider": "standard"
        }
      ],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]*$"
          },
          "module": {
            "type": "string",
            "minLength": 1
          },
          "allow": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "limits": {
      "default": {},
      "type": "object",
      "properties": {
        "max_model_calls": {
          "default": 30,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_tool_calls": {
          "default": 100,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "max_output_tokens": {
          "default": 16000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "debug": {
      "default": {},
      "type": "object",
      "properties": {
        "persist_raw": {
          "default": false,
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "company",
    "principal",
    "profession"
  ],
  "additionalProperties": false
}
