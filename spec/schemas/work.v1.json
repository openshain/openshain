{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "work.json",
  "description": "The state of a work as projected from its event log. Never the source of truth.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "principal": {
      "type": "string"
    },
    "profession": {
      "type": "string"
    },
    "type": {
      "type": "string"
    },
    "objective": {
      "type": "string"
    },
    "parent": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "in_progress",
        "waiting_input",
        "waiting_approval",
        "waiting_external",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "outcome": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string"
              },
              "missing": {
                "type": "boolean",
                "const": true
              },
              "claimed": {
                "type": "boolean",
                "const": true
              }
            },
            "required": [
              "path",
              "sha256"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "summary",
        "artifacts"
      ],
      "additionalProperties": false
    },
    "failure": {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        }
      },
      "required": [
        "reason",
        "detail"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "id",
    "principal",
    "profession",
    "type",
    "objective",
    "status",
    "created_at"
  ],
  "additionalProperties": false
}
