{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "knowledge/sources/*.md (front matter)",
  "description": "Where a cited document came from, when it applies, and who may read it.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "publisher": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "url": {
      "type": "string",
      "format": "uri"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "retrieved_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "effective_from": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "effective_to": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "scope": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "visibility": {
              "type": "string",
              "const": "company"
            }
          },
          "required": [
            "visibility"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "principals": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              }
            }
          },
          "required": [
            "principals"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "roles": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[a-z0-9][a-z0-9._-]*$"
              }
            }
          },
          "required": [
            "roles"
          ],
          "additionalProperties": false
        }
      ]
    },
    "expertise": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40,
      "pattern": "^[a-z][a-z0-9-]*$"
    }
  },
  "required": [
    "id",
    "title",
    "publisher",
    "retrieved_at",
    "effective_from",
    "effective_to",
    "expertise"
  ],
  "additionalProperties": false
}
