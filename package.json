{
  "name": "openshain-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "bun": ">=1.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "schemas": "bun scripts/generate-schemas.ts",
    "build": "bun build --compile packages/cli/src/bin.ts --outfile dist/openshain"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/bun": "1.4.0",
    "typescript": "7.0.2"
  }
}
