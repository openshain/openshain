{
  "name": "openshain",
  "version": "0.2.0",
  "description": "Reference CLI of the openshain agent harness",
  "keywords": [
    "openshain",
    "agent",
    "runtime",
    "mcp",
    "accounting",
    "japan"
  ],
  "author": "Hiroki Nakatani",
  "license": "Apache-2.0",
  "homepage": "https://openshain.jp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openshain/openshain.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/openshain/openshain/issues",
  "type": "module",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "openshain": "./dist/bin.js"
  },
  "scripts": {
    "build": "../../node_modules/.bin/tsc -p tsconfig.build.json",
    "prepublishOnly": "rm -rf dist && ../../node_modules/.bin/tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openshain/agent": "workspace:*",
    "@openshain/core": "workspace:*",
    "@openshain/mcp": "workspace:*",
    "@openshain/tools": "workspace:*",
    "ink": "7.1.1",
    "react": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "ink-testing-library": "4.0.0"
  }
}
