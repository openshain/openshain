{
  "name": "openshain",
  "version": "0.1.0",
  "description": "Reference CLI agent for the openshain runtime",
  "keywords": [
    "openshain",
    "agent",
    "runtime",
    "mcp",
    "accounting",
    "japan"
  ],
  "author": "Hiroki Nakatani",
  "license": "Apache-2.0",
  "homepage": "https://github.com/openshain/openshain",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openshain/openshain.git",
    "directory": "packages/cli"
  },
  "bugs": "https://github.com/openshain/openshain/issues",
  "type": "module",
  "engines": {
    "bun": ">=1.3"
  },
  "files": [
