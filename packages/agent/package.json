{
  "name": "@openshain/agent",
  "version": "0.2.0",
  "description": "Tool loop and model providers (bring your own key)",
  "keywords": [
    "openshain",
    "agent",
    "runtime",
    "mcp",
    "accounting",
    "japan"
  ],
  "author": "Hiroki Nakatani",
  "license": "Apache-2.0",
  "homepage": "https://openshain.jp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openshain/openshain.git",
    "directory": "packages/agent"
  },
  "bugs": "https://github.com/openshain/openshain/issues",
  "type": "module",
  "engines": {
    "node": ">=22",
    "bun": ">=1.3"
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "bun": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "../../node_modules/.bin/tsc -p tsconfig.build.json",
    "prepublishOnly": "rm -rf dist && ../../node_modules/.bin/tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.123.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openshain/core": "workspace:*",
    "openai": "7.10.0"
  },
  "devDependencies": {
    "@openshain/mcp": "workspace:*",
    "@openshain/tools": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  }
}
